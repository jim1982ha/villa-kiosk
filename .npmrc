# The resolver settings this repository is built with — the SAME on a
# developer's machine, the CI runner and the image's build stage.
#
# ⚠️ legacy-peer-deps=false IS THE WHOLE REASON THIS FILE EXISTS (2.496.209).
# A user-level ~/.npmrc on the machine that wrote every lockfile in this
# repository's history had `legacy-peer-deps=true`, so peer dependencies were
# never resolved locally and the committed lockfile described a tree npm
# would not build anywhere else. On the runner and in the image, `npm install`
# quietly rewrote it (100 lines in, 310 out — @babel/core hoisted) and
# `npm ci` refused it outright, which is the "runner-only failure" that
# ci.yaml and the Dockerfile blamed on the runner for 180 releases. A project
# .npmrc outranks the user's, so the lockfile is now written the way it is
# read.
legacy-peer-deps=false
