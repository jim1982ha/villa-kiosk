# VESTA Agent host — standalone settings. Copy to vesta-agent.env and fill in.
# ⚠️ vesta-agent.env holds secrets: it is gitignored; never commit or share it.
# Each VESTA_OPT_<NAME> is the HA app option <name> (see the app's DOCS.md).

VESTA_OPT_ANTHROPIC_API_KEY=

# Home Assistant as reached from where this runs (a tunnel address when remote).
VESTA_OPT_HA_URL=https://ha.example.com
VESTA_OPT_HA_TOKEN=

# The HA MCP server runs inside this container and uses the token above.

VESTA_OPT_KIOSK_URL=https://kiosk.example.com
VESTA_OPT_KIOSK_AGENT_TOKEN=

VESTA_OPT_TELEGRAM_TAKEOVER=false
VESTA_OPT_TELEGRAM_BOT_TOKEN=
VESTA_OPT_LOG_LEVEL=info

# Remote only: the Cloudflare Access service token in front of the villa.
VESTA_CF_ACCESS_CLIENT_ID=
VESTA_CF_ACCESS_CLIENT_SECRET=

# prod or dev (defaults to the image's channel); the villa's time zone.
VESTA_INSTANCE=
TZ=UTC
