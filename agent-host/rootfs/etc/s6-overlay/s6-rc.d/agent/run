#!/bin/sh
# The agent slot (SPEC 10). `init-vesta` has already validated the options and
# written the agent's environment to /run/vesta; the slot reads only that, so no
# container variable (SUPERVISOR_TOKEN, VESTA_OPT_*) can leak to agent code.
#
# `exec` so s6's SIGTERM on stop reaches the slot directly, which forwards it
# to the agent and waits up to the manifest's stop_grace_seconds.
exec /usr/bin/vesta-agent-slot
