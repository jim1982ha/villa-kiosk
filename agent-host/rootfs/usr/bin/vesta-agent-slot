#!/usr/bin/env python3
"""The agent slot: self-test, then start what the manifest names (SPEC 8, 10, 11).

s6 runs this as the `agent` longrun after `init-vesta` has prepared
/run/vesta. It knows the agent only through `vesta-agent.yaml` (SPEC H2):
  stub mode  → /opt/vesta/stub, after one self-test that never blocks;
  agent mode → /opt/vesta/agent, only once Home Assistant AND Anthropic pass
               (retried with backoff, SPEC 11) — an agent started without
               either would only fail on its own and restart in a loop.

⚠️ THE AGENT'S OUTPUT PASSES THROUGH THE REDACTION FILTER. The agent is told
never to print a secret (SPEC 8 rule 3); this is what holds when it does anyway.
Every line it writes is read here, masked, and only then reaches the log.
"""
from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import threading

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                "..", "..", "opt", "vesta", "host"))

from vesta_host import paths, selftest  # noqa: E402
from vesta_host.log import configure, log  # noqa: E402
from vesta_host.redact import Redactor  # noqa: E402

DEFAULT_GRACE = 20
#: Agent-mode gate backoff: 5 s doubling to 5 min, as s6's restart policy.
BACKOFF_START, BACKOFF_MAX = 5, 300
GATE = ("home_assistant", "anthropic")

stop = threading.Event()


def gate(env: dict[str, str], host: dict) -> bool:
    """Agent mode: wait until Home Assistant and Anthropic pass. False = stopped."""
    delay = BACKOFF_START
    while not stop.is_set():
        results = selftest.execute(env, host, only=GATE, write=False)
        failing = [r.link for r in results if r.result != selftest.PASS]
        if not failing:
            return True
        log("warning", f"agent start delayed: {', '.join(failing)} not passing — retry in {delay} s")
        if stop.wait(delay):
            return False
        delay = min(delay * 2, BACKOFF_MAX)
    return False


def run_program(folder, env: dict[str, str], redactor: Redactor) -> int:
    import yaml
    manifest = yaml.safe_load((folder / paths.MANIFEST).read_text()) or {}
    start = manifest.get("start")
    if not start:
        log("error", f"{folder / paths.MANIFEST} has no `start` command")
        return 1
    grace = int(manifest.get("stop_grace_seconds") or DEFAULT_GRACE)
    log("info", f"starting {manifest.get('name', 'agent')} {manifest.get('version', '')}".rstrip())

    # Own session, so a stop reaches the agent's whole process group, not only
    # the shell that launched it.
    proc = subprocess.Popen(
        ["/bin/sh", "-c", str(start)], cwd=folder, env=env,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        start_new_session=True, text=True, errors="replace", bufsize=1)

    def pump() -> None:
        assert proc.stdout is not None
        for line in proc.stdout:
            print(redactor(f"[agent] {line.rstrip()}"), flush=True)

    reader = threading.Thread(target=pump, daemon=True)
    reader.start()

    while proc.poll() is None and not stop.wait(0.5):
        pass
    if proc.poll() is None:
        log("info", f"stopping agent (grace {grace} s)")
        os.killpg(proc.pid, signal.SIGTERM)
        try:
            proc.wait(timeout=grace)
        except subprocess.TimeoutExpired:
            log("warning", f"agent still running after {grace} s — killing it")
            os.killpg(proc.pid, signal.SIGKILL)
            proc.wait()
    reader.join(timeout=2)
    code = proc.returncode
    if stop.is_set() and code in (0, -signal.SIGTERM, 128 + signal.SIGTERM):
        # The launching shell dies of the SIGTERM it was sent: a clean stop.
        log("info", "agent stopped cleanly")
    else:
        log("info" if code == 0 else "warning", f"agent exited with code {code}")
    return 0 if stop.is_set() else (code or 0)


def main() -> int:
    redactor = Redactor.load(paths.REDACT)
    try:
        env = json.loads(paths.AGENT_ENV.read_text())
        host = json.loads(paths.HOST_STATE.read_text())
    except (OSError, ValueError):
        configure("info", redactor)
        log("error", "no prepared environment in /run/vesta — init-vesta did not run")
        return 1
    configure(env.get("VESTA_LOG_LEVEL", "info"), redactor)
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    signal.signal(signal.SIGINT, lambda *_: stop.set())

    mode = host.get("agent_mode", "stub")
    # SPEC 11: at every start, in both modes. Stub mode never stops on it.
    selftest.execute(env, host)

    if mode == "stub":
        folder = paths.STUB_DIR
        # The only variable outside the contract, and only for the stub: it is
        # host test machinery, not something any real agent is given.
        if host.get("stub_heartbeat"):
            env = {**env, "VESTA_STUB_HEARTBEAT": "true"}
    else:
        folder = paths.AGENT_DIR
        if not (folder / paths.MANIFEST).exists():
            log("error", "agent mode, but this image contains no VESTA Agent "
                         "(built without AGENT_REF) — switch agent_mode to stub")
            stop.wait()
            return 0
        if not gate(env, host):
            return 0

    if not (folder / paths.MANIFEST).exists():
        log("info", f"agent slot empty: no {paths.MANIFEST} in {folder} — idle")
        stop.wait()
        return 0
    return run_program(folder, env, redactor)


if __name__ == "__main__":
    sys.exit(main())
