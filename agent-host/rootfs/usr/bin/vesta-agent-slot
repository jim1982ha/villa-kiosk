#!/usr/bin/env python3
"""The agent slot: starts what the agent manifest names, with the contract.

s6 runs this as the `agent` longrun after `init-vesta` has prepared
/run/vesta. It knows the agent only through `vesta-agent.yaml` (SPEC 8, H2).

⚠️ THE AGENT'S OUTPUT PASSES THROUGH THE REDACTION FILTER. The agent is told
never to print a secret (SPEC 8 rule 3); this is what holds when it does anyway.
Every line it writes is read here, masked, and only then reaches the log.
"""
from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import threading

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                "..", "..", "opt", "vesta", "host"))

from vesta_host import paths  # noqa: E402
from vesta_host.log import configure, log  # noqa: E402
from vesta_host.redact import Redactor  # noqa: E402

DEFAULT_GRACE = 20


def main() -> int:
    redactor = Redactor.load(paths.REDACT)
    try:
        env = json.loads(paths.AGENT_ENV.read_text())
    except (OSError, ValueError):
        configure("info", redactor)
        log("error", "no prepared environment in /run/vesta — init-vesta did not run")
        return 1
    configure(env.get("VESTA_LOG_LEVEL", "info"), redactor)

    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    signal.signal(signal.SIGINT, lambda *_: stop.set())

    if not paths.AGENT_MANIFEST.exists():
        log("info", "agent slot empty: no vesta-agent.yaml — idle")
        stop.wait()
        return 0

    import yaml
    manifest = yaml.safe_load(paths.AGENT_MANIFEST.read_text()) or {}
    start = manifest.get("start")
    if not start:
        log("error", "vesta-agent.yaml has no `start` command")
        return 1
    grace = int(manifest.get("stop_grace_seconds") or DEFAULT_GRACE)
    log("info", f"starting {manifest.get('name', 'agent')} {manifest.get('version', '')}".rstrip())

    # Own session, so a stop reaches the agent's whole process group, not only
    # the shell that launched it.
    proc = subprocess.Popen(
        ["/bin/sh", "-c", str(start)], cwd=paths.AGENT_DIR, env=env,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        start_new_session=True, text=True, errors="replace", bufsize=1)

    def pump() -> None:
        assert proc.stdout is not None
        for line in proc.stdout:
            print(redactor(f"[agent] {line.rstrip()}"), flush=True)

    reader = threading.Thread(target=pump, daemon=True)
    reader.start()

    while proc.poll() is None and not stop.wait(0.5):
        pass
    if proc.poll() is None:
        log("info", f"stopping agent (grace {grace} s)")
        os.killpg(proc.pid, signal.SIGTERM)
        try:
            proc.wait(timeout=grace)
        except subprocess.TimeoutExpired:
            log("warning", f"agent still running after {grace} s — killing it")
            os.killpg(proc.pid, signal.SIGKILL)
            proc.wait()
    reader.join(timeout=2)
    code = proc.returncode
    log("info" if code == 0 or stop.is_set() else "warning", f"agent exited with code {code}")
    return 0 if stop.is_set() else (code or 0)


if __name__ == "__main__":
    sys.exit(main())
