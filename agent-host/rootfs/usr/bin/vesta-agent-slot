#!/usr/bin/env python3
"""The agent slot: self-test, then run what the manifest names (SPEC 8, 10, 11).

s6 runs this as the `agent` longrun after `init-vesta` and `ha-mcp`. It knows
the agent only through `vesta-agent.yaml` (SPEC H2):
  stub mode  → /opt/vesta/stub, after one self-test that never blocks;
  agent mode → /opt/vesta/agent, only once Home Assistant AND Anthropic pass
               (retried with backoff, SPEC 11) — an agent started without
               either would only fail on its own and restart in a loop.
Then it keeps the program running under the restart policy (supervise.py):
backoff 5 s → 5 min, and no more restarts after 5 crashes in 10 min.

⚠️ THE AGENT'S OUTPUT PASSES THROUGH THE REDACTION FILTER. The agent is told
never to print a secret (SPEC 8 rule 3); this is what holds when it does anyway.
"""
from __future__ import annotations

import json
import os
import signal
import socket
import sys
import threading
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                "..", "..", "opt", "vesta", "host"))

from vesta_host import contract, paths, selftest, supervise  # noqa: E402
from vesta_host.log import configure, log  # noqa: E402
from vesta_host.redact import Redactor  # noqa: E402

DEFAULT_GRACE = 20
#: ⚠️ THE WHOLE STOP MUST FIT IN THE SUPERVISOR'S `timeout: 30`: the agent's
#: grace, then the sidecar's 3 s, then s6's own teardown. A manifest asking for
#: more is capped here rather than being SIGKILLed by Docker mid-save.
MAX_GRACE = 22
#: Agent-mode gate backoff, same curve as the restart policy.
GATE = ("home_assistant", "anthropic")
#: How long the sidecar may take to listen before the self-test runs anyway
#: (and reports it failing). A Python server on the Yellow's CPU is not instant.
SIDECAR_WAIT = 120

stop = threading.Event()


def wait_for_sidecar(host: dict) -> None:
    if host.get("ha_mcp_mode") != "sidecar" or host.get("sidecar_reason"):
        return
    deadline = time.monotonic() + SIDECAR_WAIT
    while time.monotonic() < deadline and not stop.is_set():
        try:
            socket.create_connection((contract.SIDECAR_HOST, contract.SIDECAR_PORT), timeout=1).close()
            return
        except OSError:
            stop.wait(0.5)
    if not stop.is_set():
        log("warning", f"HA MCP sidecar not listening after {SIDECAR_WAIT} s")


def gate(env: dict[str, str], host: dict) -> bool:
    """Agent mode: wait until Home Assistant and Anthropic pass. False = stopped."""
    delay = supervise.BACKOFF_START
    while not stop.is_set():
        results = selftest.execute(env, host, only=GATE, write=False)
        failing = [r.link for r in results if r.result != selftest.PASS]
        if not failing:
            return True
        log("warning", f"agent start delayed: {', '.join(failing)} not passing — retry in {delay} s")
        if stop.wait(delay):
            return False
        delay = min(delay * 2, supervise.BACKOFF_MAX)
    return False


def main() -> int:
    redactor = Redactor.load(paths.REDACT)
    try:
        env = json.loads(paths.AGENT_ENV.read_text())
        host = json.loads(paths.HOST_STATE.read_text())
    except (OSError, ValueError):
        configure("info", redactor)
        log("error", "no prepared environment in /run/vesta — init-vesta did not run")
        return 1
    configure(env.get("VESTA_LOG_LEVEL", "info"), redactor)
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    signal.signal(signal.SIGINT, lambda *_: stop.set())

    mode = host.get("agent_mode", "stub")
    wait_for_sidecar(host)
    if stop.is_set():
        return 0
    # SPEC 11: at every start, in both modes. Stub mode never stops on it.
    selftest.execute(env, host)

    if mode == "stub":
        folder = paths.STUB_DIR
        # The only variable outside the contract, and only for the stub: it is
        # host test machinery, not something any real agent is given.
        if host.get("stub_heartbeat"):
            env = {**env, "VESTA_STUB_HEARTBEAT": "true"}
    else:
        folder = paths.AGENT_DIR
        if not (folder / paths.MANIFEST).exists():
            log("error", "agent mode, but this image contains no VESTA Agent "
                         "(built without AGENT_REF) — switch agent_mode to stub")
            stop.wait()
            return 0
        if not gate(env, host):
            return 0

    if not (folder / paths.MANIFEST).exists():
        log("info", f"agent slot empty: no {paths.MANIFEST} in {folder} — idle")
        stop.wait()
        return 0

    import yaml
    manifest = yaml.safe_load((folder / paths.MANIFEST).read_text()) or {}
    start = manifest.get("start")
    if not start:
        log("error", f"{folder / paths.MANIFEST} has no `start` command")
        stop.wait()
        return 0
    grace = int(manifest.get("stop_grace_seconds") or DEFAULT_GRACE)
    if grace > MAX_GRACE:
        log("warning", f"stop_grace_seconds {grace} capped to {MAX_GRACE}: the whole stop "
                       "must fit in the app's 30 s timeout")
        grace = MAX_GRACE
    name = f"{manifest.get('name', 'agent')} {manifest.get('version', '')}".rstrip()

    def once() -> int | None:
        log("info", f"starting {name}")
        return supervise.run_once(["/bin/sh", "-c", str(start)], folder, env,
                                  "agent", grace, stop, redactor)

    supervise.keep_running(once, name, stop, supervise.CrashLog(paths.CRASHES))
    return 0


if __name__ == "__main__":
    sys.exit(main())
