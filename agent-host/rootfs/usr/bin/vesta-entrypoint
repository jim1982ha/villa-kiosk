#!/usr/bin/env python3
"""Start-up of the VESTA Agent host (SPEC 10: read options → validate → …).

Runs once per container start as the s6 oneshot `init-vesta`, before any
longrun. It reads and validates the options, prints the start banner, creates
the persistent folders and writes the agent's environment to /run/vesta.

⚠️ A NON-ZERO EXIT STOPS THE CONTAINER. The HA base image sets
S6_BEHAVIOUR_IF_STAGE2_FAILS=2, so a failed oneshot ends the start-up — which is
what SPEC 6 asks for in agent mode ("a missing key stops the start with a clear
message"): the message is the last line in the app's log.
"""
from __future__ import annotations

import json
import os
import sys
import time
from urllib.parse import urlsplit

# /usr/bin/../../opt/vesta/host in the image; rootfs/… in the repository.
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                "..", "..", "opt", "vesta", "host"))

from vesta_host import contract, layout, options, paths  # noqa: E402
from vesta_host import manifest as agent_manifest  # noqa: E402
from vesta_host.host_state import HostState  # noqa: E402
from vesta_host.log import configure, log  # noqa: E402
from vesta_host.redact import Redactor  # noqa: E402


def origin(url: object) -> str:
    """scheme://host:port only — a path or query may carry a secret."""
    u = urlsplit(str(url or ""))
    if not u.hostname:
        return "not set"
    port = f":{u.port}" if u.port else ""
    return f"{u.scheme}://{u.hostname}{port}"


def agent_identity(mode: object = "agent") -> str:
    return agent_manifest.identity((paths.STUB_DIR if mode == "stub" else paths.AGENT_DIR) / paths.MANIFEST)


def banner(o: options.Options) -> None:
    def state(name: str) -> str:
        return "set" if o.has(name) else "missing"

    mode = o.get("agent_mode")
    log("info", f"VESTA Agent host {os.environ.get('VESTA_HOST_VERSION', 'dev')}"
                f" · deployment {o.deployment} · instance {contract.instance()}")
    log("info", f"agent slot: mode {mode} · runs {agent_identity(mode)}")
    log("info", f"link Home Assistant: {origin(o.get('ha_url'))} · token {state('ha_token')}")
    if o.get("ha_mcp_mode") == "external":
        log("info", f"link HA MCP: external {origin(o.get('ha_mcp_url'))}"
                    f" · secret {state('ha_mcp_secret')}")
    else:
        log("info", f"link HA MCP: sidecar {contract.SIDECAR_HOST}:{contract.SIDECAR_PORT}")
    log("info", f"link VESTA Kiosk: {origin(o.get('kiosk_url'))}"
                f" · token {state('kiosk_agent_token')}")
    log("info", f"link Anthropic: key {state('anthropic_api_key')}")
    if o.get("telegram_takeover"):
        log("info", f"link Telegram: ENABLED · token {state('telegram_bot_token')}")
    else:
        log("info", "link Telegram: disabled (takeover off) — no token exported, no call made")
    log("info", f"time zone: {os.environ.get('TZ', 'UTC')} · log level {o.get('log_level')}")


def write_private(path, data: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.touch(mode=0o600, exist_ok=True)
    path.chmod(0o600)
    path.write_text(json.dumps(data))


def sidecar_settings(o: options.Options) -> dict:
    """The HA MCP sidecar's settings (SPEC 12). Its own environment, like the
    agent's: SUPERVISOR_TOKEN and VESTA_OPT_* never reach it either."""
    base = {"log_level": o.get("log_level"), "version": os.environ.get("VESTA_HA_MCP_VERSION", "")}
    if o.get("ha_mcp_mode") == "external":
        return {**base, "enabled": False, "reason": "external mode — the agent uses ha_mcp_url"}
    if not o.has("ha_token"):
        return {**base, "enabled": False, "reason": "ha_token not set"}
    return {**base, "enabled": True, "env": {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "HOME": str(paths.SIDECAR_HOME),
        "LANG": "C.UTF-8",
        "TZ": os.environ.get("TZ", "UTC"),
        "HOMEASSISTANT_URL": str(o.get("ha_url")),
        "HOMEASSISTANT_TOKEN": str(o.get("ha_token")),
        # ⚠️ LOOPBACK ONLY. ha-mcp-web binds 0.0.0.0 by default.
        "MCP_HOST": contract.SIDECAR_HOST,
        "MCP_PORT": str(contract.SIDECAR_PORT),
        "MCP_SECRET_PATH": contract.SIDECAR_PATH,
        # Its browser settings page is for people; nobody browses in here.
        "HA_MCP_DISABLE_SETTINGS_UI": "1",
        "LOG_LEVEL": str(o.get("log_level") or "info").upper(),
        # ⚠️ NO SELF-UPDATE MACHINERY. The version is pinned and upgraded only
        # deliberately (SPEC 12), so asking PyPI on every start is noise — and
        # ha-mcp's update check also drives its "HACS nudge", which sends
        # `hacs/repository/refresh` to Home Assistant: a change to the house
        # made merely because the agent's sidecar started. One switch stops both.
        "HA_MCP_DISABLE_UPDATE_CHECK": "1",
        "FASTMCP_CHECK_FOR_UPDATES": "off",
        "FASTMCP_SHOW_SERVER_BANNER": "false",
    }}


def main() -> int:
    o = options.load()
    redactor = Redactor(o.secrets())
    configure(str(o.get("log_level") or "info"), redactor)

    banner(o)
    for note in o.notes:
        log("info", note)
    if o.errors:
        for err in o.errors:
            log("error", err)
        log("error", "not starting: fix the options above and start the app again")
        return 1

    for path in layout.ensure():
        log("info", f"created {path}")

    env = contract.build(o)
    write_private(paths.AGENT_ENV, contract.process_env(env))
    redactor.save(paths.REDACT)
    sidecar = sidecar_settings(o)
    write_private(paths.SIDECAR_ENV, sidecar)
    # What the slot and the self-test need that is NOT part of the contract:
    # which program fills the slot, whether the stub sends heartbeats, and
    # whether the sidecar runs (and if not, why).
    HostState(
        agent_mode=str(o.get("agent_mode") or "stub"),
        stub_heartbeat=bool(o.get("stub_heartbeat")),
        ha_mcp_mode=str(o.get("ha_mcp_mode") or "sidecar"),
        sidecar_reason=None if sidecar["enabled"] else sidecar["reason"],
        host_version=os.environ.get("VESTA_HOST_VERSION", "dev"),
    ).write(paths.HOST_STATE)

    # What started, when — never a secret. For a person diagnosing the app,
    # including from a backup.
    (paths.DATA_HOST / "last_start.json").write_text(json.dumps({
        "at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "host_version": os.environ.get("VESTA_HOST_VERSION", "dev"),
        "deployment": o.deployment,
        "instance": contract.instance(),
        "agent_mode": o.get("agent_mode"),
        "agent": agent_identity(o.get("agent_mode")),
    }, indent=2))
    log("info", "start-up checks passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
