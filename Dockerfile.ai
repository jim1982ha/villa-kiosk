# The VESTA AI Layer add-on image. Headless: no nginx, no Ingress, no port.
#
# ⚠️ A SEPARATE IMAGE FROM THE KIOSK, BUILT FROM A SEPARATE BRANCH. The kiosk
# ships from `dev2` and is not rebuilt here; this ships from `ai` and contains
# none of the kiosk. One branch, one published artifact — which is also why
# `agent/` is never copied into the kiosk image and `src/` is never copied into
# this one.
#
# Floating base tag on purpose, like the kiosk's: HA's security patches arrive
# automatically, at the cost of builds not being byte-for-byte reproducible.
ARG BUILD_FROM=ghcr.io/home-assistant/amd64-base:latest
FROM ${BUILD_FROM}

# ⚠️ BAKED IN, BECAUSE SUPERVISOR DOES NOT TELL AN ADD-ON ITS OWN VERSION.
# `__main__.read_version()` read `VESTA_AI_VERSION` from the environment and
# nothing ever set it — so the first real install published `version: "0"` in
# its own status entity and its own log. There is no Supervisor-provided
# variable for this; the build is the only place that knows the number, and CI
# already reads it out of vesta-ai/config.yaml to tag the image.
ARG VESTA_AI_VERSION=0
ENV VESTA_AI_VERSION=${VESTA_AI_VERSION}

# python3 + aiohttp as APKs rather than pip: they are the same packages the
# kiosk's proxy runs on, they carry the base image's own security updates, and
# the layer needs no wheel that alpine does not already package.
#
# ⚠️ NO ANTHROPIC SDK YET. Nothing in this release calls a model, and shipping
# the client for a call that cannot happen would put a credential path in an
# image that has no use for one. Ticket 19 adds it, behind the permission gate.
# ⚠️ tzdata IS NOT OPTIONAL. alpine ships no zone database, so `zoneinfo`
# raises ZoneInfoNotFoundError for every name — and the layer's own fallback
# would then quietly use UTC for a `timezone` the operator had set, working
# perfectly on a developer's machine and silently wrong on the wall.
RUN apk add --no-cache python3 py3-aiohttp tzdata

# The s6 service that runs it, and the layer itself.
COPY rootfs-ai /
COPY agent /usr/lib/vesta/agent
# ⚠️ THE TESTS DO NOT SHIP, AND A GUARD DEPENDS ON THAT. `tests/hard-rules.py`
# exempts this tree from the "nothing is fetched from a third party" rule on the
# stated grounds that a fixture's fake address is never fetched and never
# reaches an image. Deleting it here is what makes that sentence true; a
# .dockerignore would apply to the kiosk's build context as well.
RUN rm -rf /usr/lib/vesta/agent/tests

# ⚠️ THE SHAPE, NOT A LIST OF PATHS. git stores every file as 0644, including
# s6 `run` scripts, so this chmod is load-bearing — and enumerating its targets
# by hand is how a second longrun gets added, builds green, publishes, and then
# fails to exec on the wall with no build-time signal anywhere.
RUN find /etc/s6-overlay/s6-rc.d -name run -exec chmod a+x {} +

LABEL \
  io.hass.name="VESTA AI Layer" \
  io.hass.description="Suggest-only property intelligence for Home Assistant" \
  io.hass.type="addon"
# The add-on version is the single source of truth in vesta-ai/config.yaml; the
# Supervisor reads it from there, so it is intentionally NOT duplicated here.

# No CMD/ENTRYPOINT: the base image's /init (s6-overlay) starts the longrun
# registered under rootfs-ai/etc/s6-overlay/s6-rc.d/.
