{
  "name": "villa-kiosk",
  "private": true,
  "version": "2.960.0",
  "description": "VESTA — a 3D interactive villa dashboard for Home Assistant",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist node_modules/.vite tsconfig.tsbuildinfo",
    "predev": "npm run clean",
    "dev": "vite",
    "prebuild": "npm run clean",
    "build": "tsc -b && vite build",
    "prepreview": "npm run build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "test:placement": "node --import ./tests/consistency/register.mjs tests/consistency/badge_placement_test.ts",
    "test:geometry": "node --import ./tests/consistency/register.mjs tests/consistency/geometry_test.ts",
    "test:consistency": "node --import ./tests/consistency/register.mjs tests/consistency/kiosk_view.ts",
    "test:config-delta": "node --import ./tests/consistency/register.mjs tests/consistency/config_delta_test.ts",
    "test:module-toggle": "node --import ./tests/consistency/register.mjs tests/consistency/module_toggle_test.ts",
    "test:when": "node --import ./tests/consistency/register.mjs tests/consistency/when_test.ts",
    "test:concern-narrative": "node --import ./tests/consistency/register.mjs tests/consistency/concern_narrative_test.ts",
    "test:reports-workspace": "node --import ./tests/consistency/register.mjs tests/consistency/reports_workspace_test.ts",
    "test:entity-value": "node --import ./tests/consistency/register.mjs tests/consistency/entity_value_test.ts",
    "test:resolution-valve": "node --import ./tests/consistency/register.mjs tests/consistency/resolution_valve_test.ts",
    "test:villa-rules": "node --import ./tests/consistency/register.mjs tests/consistency/villa_rules.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^7.37.2",
    "@babylonjs/gui": "^7.54.3",
    "@babylonjs/loaders": "^7.37.2",
    "@babylonjs/materials": "^7.54.3",
    "babylonjs-ktx2decoder": "^9.19.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.6.3",
    "vite": "^8.1.5"
  }
}
