  "version": "2.235.0",
  "description": "VESTA \u2014 a 3D interactive villa dashboard for Home Assistant",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist node_modules/.vite tsconfig.tsbuildinfo",
    "predev": "npm run clean",
    "dev": "vite",
    "prebuild": "npm run clean",
    "build": "tsc -b && vite build",
    "prepreview": "npm run build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "test:placement": "node tests/badge_placement_test.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^7.37.2",
