#!/bin/sh
# Refuse a commit on `main`: work goes on agent-dev (the Agent) or dev2 (the Kiosk).
# Escape hatch: VK_ALLOW_MAIN=1 git commit ...
if [ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" = "main" ] && [ "${VK_ALLOW_MAIN:-}" != "1" ]; then
  echo "  ✋ REFUSED: committing on 'main'. Work on agent-dev or dev2." >&2
  exit 1
fi
