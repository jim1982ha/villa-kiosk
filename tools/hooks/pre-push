#!/bin/sh
# Refuse a push to origin/main: main is written only by CI's channel sync and by
# the owner-approved Kiosk backport. Escape hatch: VK_ALLOW_MAIN=1 git push ...
[ "${VK_ALLOW_MAIN:-}" = "1" ] && exit 0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "  ✋ REFUSED: pushing to origin/main. Push agent-dev (or dev2) instead." >&2
    echo "     If this really is a backport:  VK_ALLOW_MAIN=1 git push origin main" >&2
    exit 1
  fi
done
exit 0
