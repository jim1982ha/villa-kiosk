# Villa Kiosk — environment defaults
# Copy to ".env" and fill in. All values are OPTIONAL.
#
# There is no HA URL/token here: the kiosk is always served by the add-on and
# reaches Home Assistant token-less through its Supervisor proxy. Profile
# passcodes are configured in the add-on options (guest_pin / owner_pin /
# ops_pin) and verified server-side — they never live in the client bundle.

# --- Villa location for sun tracking (Bali / TheLysHouse) ---
# Only a fallback before the app adopts the connected HA instance's own
# latitude/longitude on connect.
VITE_LAT=-8.3405
VITE_LNG=115.0920

# --- Dev-only backend proxy (npm run dev) ---
# The app always talks to the add-on backend (/core, /auth, /addon-config,
# /model, /model-upload). For local UI development against a REAL Home
# Assistant, point this at a running Villa Kiosk add-on's own hostname/port so
# Vite forwards those routes to it. Leave unset to develop the UI shell alone
# (backend calls will 404, which is fine for pure visual work).
# VITE_DEV_PROXY=http://homeassistant.local:8099
